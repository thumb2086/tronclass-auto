{
  "name": "tronclass-auto-gui",
  "version": "1.7.5",
  "description": "Electron wrapper for tronclass-auto",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --mac --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "tronclass-auto": "file:.."
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.tronclass.auto",
    "productName": "TronClass Auto",
    "win": {
      "target": "nsis",
      "icon": null
    },
    "mac": {
      "target": "dmg",
      "icon": null
    },
    "linux": {
      "target": "AppImage",
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
